	partition FactOrders = m
		mode: import
		source =
				// Query name: FactOrders
				let
				    Source = Stg_DataCoSupplyChain,
				    MergedLocation = Table.NestedJoin(
				        Source,
				        {"Order City", "Order State", "Order Country", "Order Region", "Order Zipcode", "Market"},
				        DimOrderLocation,
				        {"Order City", "Order State", "Order Country", "Order Region", "Order Zipcode", "Market"},
				        "DimOrderLocation",
				        JoinKind.LeftOuter
				    ),
				    ExpandedLocation = Table.ExpandTableColumn(MergedLocation, "DimOrderLocation", {"Location Key"}, {"Location Key"}),
				    Selected = Table.SelectColumns(
				        ExpandedLocation,
				        {
				            "Order Item Id", "Order Id", "Order Date", "Ship Date", "Order DateTime", "Ship DateTime",
				            "Customer Id", "Order Customer Id", "Product Card Id", "Order Item Cardprod Id", "Location Key",
				            "Type", "Delivery Status", "Late Delivery Risk", "Order Status", "Shipping Mode",
				            "Days for shipping (real)", "Days for shipment (scheduled)",
				            "Order Item Quantity", "Sales", "Order Item Total", "Order Item Discount", "Order Item Discount Rate",
				            "Order Item Product Price", "Benefit per order", "Sales per customer", "Order Profit Per Order",
				            "Order Item Profit Ratio"
				        }
				    )
				in
				    Selected

	annotation PBI_NavigationStepName = Navigation

